# Core Brain Worker — Environment Variables\n# Copy this file to .env.local for local development\n# For production deployment, set these via Cloudflare Dashboard\n\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n# REQUIRED: Supabase Configuration\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n# Supabase project URL (from Supabase Settings → API)\nSUPABASE_URL=https://your-project.supabase.co\n\n# Supabase service role key (from Supabase Settings → API)\n# CRITICAL: Use service role key (rls_admin), NOT the anon public key\nSUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\n\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n# REQUIRED: Qwen LLM Configuration\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n# Qwen API key (from Alibaba Cloud Dashqwen\nQWEN_API_KEY=sk-abcdef123456...\n\n# Qwen model to use\n# Options: qwen-turbo, qwen-7b-chat, qwen-plus\nQWEN_MODEL=qwen-turbo\n\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n# REQUIRED: Security & Authentication\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n# Webhook shared secret (must match webhook request header)\n# Generate a random string: openssl rand -base64 32\nWEBHOOK_SECRET=super-secret-webhook-key-12345-change-me\n\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n# OPTIONAL: Social Platform API Keys (if routing responses directly)\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n# X/Twitter Bearer token (for sending DMs directly from Worker)\n# If not provided, responses will be queued for async sending\nX_API_KEY=AAAA...\n\n# Telegram Bot token (from BotFather)\n# If not provided, responses will be queued for async sending\nTELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11\n\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n# OPTIONAL: MPC-8302 Worker Integration (Mirror & Risk Engine)\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n# URL to the Mirror & Risk Engine Worker (MPC-8302)\n# If provided, Core Brain will delegate scan+risk operations to this Worker\n# If not provided, risk scoring will return a default score\nMIRROR_AND_RISK_WORKER_URL=https://mpt-mirror-risk.your-account.workers.dev\n\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n# DEPLOYMENT & DEBUGGING\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n# Environment: development, staging, or production\nENVIRONMENT=development\n\n# Log level: debug, info, warn, error\nLOG_LEVEL=debug\n\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n# RATE LIMITING & QUOTAS\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n# Maximum messages per minute per user (stored in KV)\nRATE_LIMIT_THRESHOLD=10\n\n# Rate limit window in seconds\nRATE_LIMIT_WINDOW=60\n\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n# DEPLOYMENT CHECKLIST\n# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\n# Before deploying to production:\n# [ ] SUPABASE_URL is correct and RLS policies are in place\n# [ ] SUPABASE_SERVICE_KEY is the service role key (not anon)\n# [ ] QWEN_API_KEY is valid and has remaining quota\n# [ ] WEBHOOK_SECRET is generated and shared with webhook sources\n# [ ] X_API_KEY / TELEGRAM_BOT_TOKEN are set if direct response routing needed\n# [ ] MIRROR_AND_RISK_WORKER_URL points to deployed MPC-8302 Worker\n# [ ] Cloudflare KV namespace is created and ID matches wrangler.toml\n# [ ] All variables are set in Cloudflare Dashboard (NOT in code)\n# [ ] Deployment guide (CORE_BRAIN_DEPLOYMENT.md) has been reviewed\n# [ ] Tests pass locally: npm test\n# [ ] Validation passes: node scripts/validate-env.js\n\n# To deploy:\n# 1. Review this file and fill in all required values\n# 2. Run: node scripts/validate-env.js\n# 3. Set variables in Cloudflare Dashboard (Settings → Variables)\n# 4. Run: wrangler deploy\n# 5. Verify: curl https://mpt-core-brain.your-account.workers.dev/\n"