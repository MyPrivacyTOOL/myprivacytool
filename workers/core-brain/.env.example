# Core Brain Worker — Environment Variables
# Copy this file to .env.local for local development
# For production deployment, set these via Cloudflare Dashboard

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# REQUIRED: Supabase Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Supabase project URL (from Supabase Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (from Supabase Settings → API)
# CRITICAL: Use service role key (rls_admin), NOT the anon public key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# REQUIRED: Qwen LLM Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Qwen API key (from Alibaba Cloud Dashqwen
QWEN_API_KEY=your-qwen-api-key

# Qwen model to use
# Options: qwen-turbo, qwen-7b-chat, qwen-plus
QWEN_MODEL=qwen-turbo

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# REQUIRED: Security & Authentication
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Webhook shared secret (must match webhook request header)
# Generate a random string: openssl rand -base64 32
WEBHOOK_SECRET=super-secret-webhook-key-12345-change-me

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OPTIONAL: Social Platform API Keys (if routing responses directly)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# X/Twitter Bearer token (for sending DMs directly from Worker)
# If not provided, responses will be queued for async sending
X_API_KEY=AAAA...

# Telegram Bot token (from BotFather)
# If not provided, responses will be queued for async sending
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OPTIONAL: MPC-8302 Worker Integration (Mirror & Risk Engine)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# URL to the Mirror & Risk Engine Worker (MPC-8302)
# If provided, Core Brain will delegate scan+risk operations to this Worker
# If not provided, risk scoring will return a default score
MIRROR_AND_RISK_WORKER_URL=https://mpt-mirror-risk.your-account.workers.dev

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DEPLOYMENT & DEBUGGING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Environment: development, staging, or production
ENVIRONMENT=development

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# RATE LIMITING & QUOTAS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Maximum messages per minute per user (stored in KV)
RATE_LIMIT_THRESHOLD=10

# Rate limit window in seconds
RATE_LIMIT_WINDOW=60

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DEPLOYMENT CHECKLIST
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Before deploying to production:
# [ ] SUPABASE_URL is correct and RLS policies are in place
# [ ] SUPABASE_SERVICE_KEY is the service role key (not anon)
# [ ] QWEN_API_KEY is valid and has remaining quota
# [ ] WEBHOOK_SECRET is generated and shared with webhook sources
# [ ] X_API_KEY / TELEGRAM_BOT_TOKEN are set if direct response routing needed
# [ ] MIRROR_AND_RISK_WORKER_URL points to deployed MPC-8302 Worker
# [ ] Cloudflare KV namespace is created and ID matches wrangler.toml
# [ ] All variables are set in Cloudflare Dashboard (NOT in code)
# [ ] Deployment guide (CORE_BRAIN_DEPLOYMENT.md) has been reviewed
# [ ] Tests pass locally: npm test
# [ ] Validation passes: node scripts/validate-env.js

# To deploy:
# 1. Review this file and fill in all required values
# 2. Run: node scripts/validate-env.js
# 3. Set variables in Cloudflare Dashboard (Settings → Variables)
# 4. Run: wrangler deploy
# 5. Verify: curl https://mpt-core-brain.your-account.workers.dev/
