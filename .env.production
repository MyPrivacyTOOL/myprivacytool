# Production build switches (MPC-8731). Public by nature: VITE_* values are compiled into the site bundle. NEVER put a secret here.
# A variable of the same name set on the Cloudflare Pages project overrides this file.
# Learning events (MPC-7915): the site sends a visitor's answer about a hexagon tile only with "Accept analytics" consent.
# Also needs the Worker var LEARNING_EVENTS_ENABLED = "true" (workers/webhook-receiver/wrangler.toml).
# Rollback: set to false (or delete the line) and merge; Privacy Policy 2.4A hides with it.
VITE_LEARNING_EVENTS=true
