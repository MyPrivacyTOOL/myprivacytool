# Production build settings that are NOT secrets (Vite loads this file for `vite build`; a Cloudflare Pages dashboard variable of the
# same name still wins). Never put a secret here.
# MPC-7915: site switch for the learning loop (visitors' "me" / "not me" answers). Pairs with the Worker var LEARNING_EVENTS_ENABLED.
# To switch off: set to "false" and merge.
VITE_LEARNING_EVENTS=true

# MPC-9817 (F3, accounts and sign-in): "true" opens /account and /account/verify (email-link sign-in, no password) and shows the one-step tick
# "Keep my scan and create my free account" at the contact step. Pairs with the Worker var ACCOUNTS_ENABLED. To switch off: set to "false" and merge.
VITE_ACCOUNTS_ENABLED=true
