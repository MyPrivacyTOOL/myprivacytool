{
  "name": "openosint-mcp",
  "version": "1.0.0",
  "description": "OpenOSINT MCP Server for MyPrivacyTOOL Wave 0 exposure scanning",
  "command": "uvx",
  "args": [
    "openosint>=2.38.2",
    "openosint.mcp_server:main"
  ],
  "env": {
    "OPENOSINT_ENV_FILE": "/app/config/.env",
    "OPENOSINT_MODE": "mcp",
    "OPENOSINT_LOG_LEVEL": "INFO",
    "OPENOSINT_TOOL_POLICY": "passive_only",
    "OPENOSINT_ALLOW_ACTIVE": "false"
  },
  "tools": {
    "mode": "auto",
    "filter": "passive",
    "timeout_seconds": 5,
    "concurrent_limit": 5,
    "provenance": {
      "enabled": true,
      "include_source": true,
      "include_confidence": true
    }
  },
  "dependencies": [
    "mcp>=1.0.0",
    "anthropic>=0.40.0",
    "openosint>=2.38.2"
  ],
  "optional_extras": [
    "shodan",
    "censys",
    "graph",
    "web"
  ],
  "deployment": {
    "platform": "cloudrun",
    "port": 8000,
    "health_check": "/health",
    "timeout_seconds": 300
  }
}
