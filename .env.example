# MPT (MyPrivacyTOOL) environment template — MPT-1004.
# Copy to `.env` for local development. `.env` is gitignored; NEVER commit real values.
# Production values live in Cloudflare (`wrangler secret put`, see SECRETS.md) and in
# GitHub Repository Settings -> Secrets and variables -> Actions.

SUPABASE_URL=your-supabase-project-url
SUPABASE_KEY=your-supabase-key
QWEN_API_KEY=your-qwen-api-key
WEBHOOK_SECRET=random-string-shared-with-social-listeners
TWILIO_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
META_APP_SECRET=your-meta-app-secret

# Site (Vite) build setting, optional: base URL of the OAuth Worker used by the header "Connected as" strip (MPC-6971).
# Default: https://myprivacytool-oauth-poc.myprivacytool.workers.dev
VITE_OAUTH_URL=
CORE_BRAIN_TOKEN=same-value-as-core-brain-WEBHOOK_SECRET

# Site (Vite) build setting, optional: Cloudflare Web Analytics (RUM) beacon token (Cloudflare dashboard -> Web Analytics).
# Unset = no beacon is loaded. Cookieless; a public site token, not a secret (MPC-7381).
VITE_CF_WEB_ANALYTICS_TOKEN=

# Site (Vite) build setting, optional (MPC-7465, MPC-7470): "true" turns on saving a visitor's scan result. The finished scan stays in the
# visitor's browser and is saved on the server only when they give an email address AND tick the separate "Save my scan result with my email ..."
# box at the contact step (decision D12). Visitors who give no email have nothing saved. No consent-tool purpose is involved
# (VITE_SCAN_SAVE_CONSENT_PURPOSE no longer exists). Needs the Worker var WEB_SCAN_SAVE_ENABLED = "true" too. Anything else = off.
# Keep OFF in production until Chris has approved the wording (MPC-7470).
VITE_SAVE_WEB_SCANS=

# MPC-7490: edge capture of every page visit (Cloudflare Pages variable, not a Vite variable). Off unless 1/true/on/yes. Keep OFF in
# production until MPC-7491 is approved. Needs SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY as Pages secrets. See docs/edge-capture.md.
EDGE_CAPTURE_ENABLED=
