# MyPrivacyTOOL (MPT) environment variables. Copy to `.env` (git-ignored) and fill in locally.
# NEVER commit real values: this file holds names and placeholders only.
# Worker secrets are set with `wrangler secret put <NAME>`; the Supabase local stack reads supabase/.env
# (see supabase/.env.example).

# --- CK-006: Progressive Trust / OSINT / messaging channels (required) ---------------------------------------
# Alibaba Qwen API key, used for the translation_queue worker.
QWEN_API_KEY=
# Twilio Account SID (starts with AC). The matching auth token is TWILIO_AUTH_TOKEN below.
TWILIO_SID=
# Meta (WhatsApp) app secret, used to verify X-Hub-Signature-256 on inbound webhooks.
META_APP_SECRET=

# --- Messaging, already used by workers/webhook-receiver --------------------------------------------------------
TWILIO_AUTH_TOKEN=

# --- Supabase (service key is server-side only, never VITE_*) -------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
